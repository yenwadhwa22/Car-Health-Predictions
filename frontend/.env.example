# Copy to .env (gitignored) — Supabase auth (dev + production)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# API URL (automatic — see committed env files):
#   npm run dev   → .env.development  → http://localhost:8000
#   npm run build → .env.production   → https://car-health-predictions-3.onrender.com
#
# Vercel (Project → Settings → Environment Variables), Production:
#   VITE_API_BASE_URL = https://car-health-predictions-3.onrender.com
# Also add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY on Vercel.
